  "name": "Lensmor",
  "theme": "maple",
  "favicon": "/logo.svg",
  "colors": {
    "primary": "#6C7CFF",
    "light": "#4F46E5",
    "dark": "#8EA0FF"
  },
  "appearance": {
    "default": "light"
  },
